{
  "name": "planban-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "check": "npm run site:preflight",
    "site:typecheck": "tsc --noEmit",
    "site:dependencies": "npm audit --audit-level=high",
    "site:build": "vite build --config vite.site.config.ts",
    "site:audit": "node scripts/audit-public-site.mjs",
    "site:preflight": "npm run site:typecheck && npm run site:dependencies && npm run site:build && npm run site:audit",
    "site:preview": "vite preview --config vite.site.config.ts",
    "site:deploy": "node scripts/deploy-site.mjs",
    "site:verify-production": "node scripts/verify-production.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.561.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@types/node": "^25.0.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "wrangler": "^4.100.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "workerd@1.20260828.1": true
  }
}
